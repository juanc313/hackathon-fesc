# Plantilla de variables de entorno del cierre.
# Copien este archivo a .env antes de levantar el entorno:
#   cp .env.example .env
# El archivo .env no se versiona (está en .gitignore).

# Base de datos del cierre (servicio cierre-db de docker-compose.yml)
POSTGRES_DB=cierre
POSTGRES_USER=cierre
POSTGRES_PASSWORD=cierre2026

# Conexión usada por cierre-api y cierre-worker.
# DATABASE_HOST es el NOMBRE DEL SERVICIO de la base en docker-compose.yml
# (cierre-db), no un nombre de host externo: los contenedores se resuelven
# entre sí por nombre de servicio dentro de la red de Compose.
DATABASE_HOST=cierre-db
DATABASE_PORT=5432
DATABASE_NAME=cierre
DATABASE_USER=cierre
DATABASE_PASSWORD=cierre2026

# Puerto de la API de consulta publicado en el host.
API_PORT=8081

# Intervalo del worker de conciliación: entero de segundos (sin sufijos).
WORKER_INTERVAL_SECONDS=30
